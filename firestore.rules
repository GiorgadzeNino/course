rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// This file is the real access control. The Angular code only decides what to
// render; anything a rule allows is readable by anyone who opens DevTools.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Granted per course: users/{uid}.courses is a map of courseId -> bool.
    function hasCourse(courseId) {
      return isSignedIn()
        && userDoc().courses[courseId] == true;
    }

    // --- users ---
    // A user reads and creates their own profile and may edit their name.
    // `courses` is deliberately NOT writable by the user — only an admin can
    // change it, which is what makes the paywall real.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.courses.size() == 0;
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.courses == resource.data.courses);
      allow delete: if isAdmin();
    }

    // --- enrollment requests ---
    // Document id is "{courseId}__{uid}", so a user gets one row per course
    // and cannot flood the collection. Status is fixed to "pending" on create;
    // only an admin can change it.
    match /enrollments/{enrollmentId} {
      // `resource` is null when the document does not exist yet. Reading a
      // missing document still goes through rules, so this case must be
      // allowed explicitly — otherwise the app is denied before the user has
      // ever requested access.
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid == resource.data.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && enrollmentId == request.resource.data.courseId + '__' + request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- lesson bodies ---
    // Free lessons are open; the rest need a grant for that specific course.
    // `free` is a boolean field on each lesson document.
    match /courses/{courseId}/lessons/{num} {
      // Same null-resource case: a lesson that has not been uploaded yet must
      // read as "missing", not as "forbidden".
      allow read: if resource == null
        || resource.data.free == true
        || hasCourse(courseId)
        || isAdmin();
      allow write: if isAdmin();
    }

    // --- admins ---
    // Managed by hand in the Firebase Console. Nothing in the app writes here.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
